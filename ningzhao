
<!DOCTYPE html>
<html lang="id">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title></title>

<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Press+Start+2P&display=swap" rel="stylesheet">

<style>
* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

body {
  background: #000;
  overflow: hidden;
  font-family: "Press Start 2P", monospace;
}

.scene {
  position: relative;
  width: 100%;
  height: 100vh;
  overflow: hidden;
  isolation: isolate;
  background:
    radial-gradient(ellipse at center, #190509, #080204 55%, #000);
}

/* LIRIK */
.lyrics-area {
  position: absolute;
  top: 34%;
  width: 100%;
  z-index: 10;
}

.lyric {
  width: 92%;
  min-height: 100px;
  margin: auto;
  display: flex;
  justify-content: center;
  align-items: center;
  align-content: center;
  flex-wrap: wrap;
  text-align: center;
  color: #ff3030;
  font-size: clamp(10px, 2vw, 17px);
  line-height: 2.5;
  text-shadow: 0 0 8px red, 0 0 25px #a00000;
}

.letter {
  display: inline-block;
  opacity: 0;
  transform: translateY(12px);
  animation: letterIn .16s ease-out forwards;
}

@keyframes letterIn {
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.lyric.fade-out {
  animation: fadeOut .5s ease-in forwards;
}

@keyframes fadeOut {
  to {
    opacity: 0;
    transform: translateX(-30px);
  }
}

.final-line {
  font-size: clamp(10px, 2vw, 17px);
}

/* ILUSTRASI UTAMA */
.art {
  position: absolute;
  left: 50%;
  top: 69%;
  z-index: 5;
  width: 100%;
  text-align: center;
  font-family: sans-serif;
  font-size: clamp(65px, 12vw, 115px);
  transform: translate(-50%, -50%);
  opacity: 0;
  pointer-events: none;
}

.art.show {
  animation: artAppear 4.8s ease-in-out forwards;
}

@keyframes artAppear {
  0% {
    opacity: 0;
    transform: translate(-50%, -30%) scale(.65);
  }
  20%, 75% {
    opacity: 1;
    transform: translate(-50%, -50%) scale(1);
  }
  100% {
    opacity: 0;
    transform: translate(-50%, -70%) scale(1.1);
  }
}

/* 1. BERPELUKAN */
.art.hug.show {
  animation: hugMotion 4.8s ease-in-out forwards;
}

@keyframes hugMotion {
  0% {
    opacity: 0;
    transform: translate(-50%, -30%) scale(.5);
  }
  20% {
    opacity: 1;
    transform: translate(-50%, -50%) scale(1.1);
  }
  35%, 65% {
    opacity: 1;
    transform: translate(-50%, -50%) scale(1);
  }
  75% {
    opacity: 1;
    transform: translate(-50%, -50%) scale(1.05);
  }
  100% {
    opacity: 0;
    transform: translate(-50%, -65%) scale(.8);
  }
}

/* 2. HATI TERHUBUNG */
.art.heart.show {
  animation: heartMotion 4.8s ease-in-out forwards;
}

@keyframes heartMotion {
  0% {
    opacity: 0;
    transform: translate(-50%, -50%) scale(.2);
  }
  25% {
    opacity: 1;
    transform: translate(-50%, -50%) scale(1.3);
  }
  40%, 65% {
    opacity: 1;
    transform: translate(-50%, -50%) scale(1);
  }
  100% {
    opacity: 0;
    transform: translate(-50%, -80%) scale(1.6);
  }
}

/* 3. NAIK TURUN KEHIDUPAN */
.art.weather.show {
  animation: weatherMotion 4.8s ease-in-out forwards;
}

@keyframes weatherMotion {
  0% {
    opacity: 0;
    transform: translate(-50%, -20%) rotate(-10deg);
  }
  20% {
    opacity: 1;
    transform: translate(-50%, -55%) rotate(8deg);
  }
  40% {
    transform: translate(-50%, -35%) rotate(-5deg);
  }
  60%, 75% {
    opacity: 1;
    transform: translate(-50%, -50%) rotate(0);
  }
  100% {
    opacity: 0;
    transform: translate(-50%, -70%);
  }
}

/* 4. MELEPASKAN */
.art.release.show {
  animation: releaseMotion 4.8s ease-in-out forwards;
}

@keyframes releaseMotion {
  0% {
    opacity: 0;
    transform: translate(-50%, -50%) scale(1);
  }
  20%, 45% {
    opacity: 1;
    transform: translate(-50%, -50%) scale(1);
  }
  75% {
    opacity: .8;
    transform: translate(-20%, -80%) scale(.75);
  }
  100% {
    opacity: 0;
    transform: translate(40%, -110%) scale(.4);
  }
}

/* 5. KENANGAN */
.art.memory.show {
  animation: memoryMotion 4.8s ease-in-out forwards;
}

@keyframes memoryMotion {
  0% {
    opacity: 0;
    transform: translate(-50%, -30%) scale(.7);
    filter: blur(4px);
  }
  25%, 65% {
    opacity: 1;
    transform: translate(-50%, -50%) scale(1);
    filter: blur(0);
  }
  100% {
    opacity: 0;
    transform: translate(-50%, -70%) scale(1.2);
    filter: blur(5px);
  }
}

/* 6. HATI PATAH */
.art.broken.show {
  animation: brokenMotion 4.8s ease-in-out forwards;
}

@keyframes brokenMotion {
  0% {
    opacity: 0;
    transform: translate(-50%, -50%) scale(1.5);
  }
  20%, 45% {
    opacity: 1;
    transform: translate(-50%, -50%) scale(1);
  }
  60% {
    transform: translate(-58%, -50%) rotate(-10deg);
  }
  70% {
    transform: translate(-42%, -50%) rotate(10deg);
  }
  100% {
    opacity: 0;
    transform: translate(-50%, -80%) scale(.5);
  }
}

/* 7. BURUNG TERBANG */
.art.bird.show {
  animation: birdMotion 4.8s ease-in-out forwards;
}

@keyframes birdMotion {
  0% {
    opacity: 0;
    transform: translate(-80%, -20%) scale(.8);
  }
  20% {
    opacity: 1;
    transform: translate(-50%, -50%) scale(1);
  }
  70% {
    opacity: 1;
    transform: translate(20%, -80%) scale(.8);
  }
  100% {
    opacity: 0;
    transform: translate(100%, -120%) scale(.5);
  }
}

/* 8. PERPISAHAN TERAKHIR */
.art.goodbye.show {
  animation: goodbyeMotion 4.8s ease-in-out forwards;
}

@keyframes goodbyeMotion {
  0% {
    opacity: 0;
    transform: translate(-50%, -30%) scale(.5);
  }
  25%, 60% {
    opacity: 1;
    transform: translate(-50%, -50%) scale(1);
  }
  75% {
    opacity: .7;
    transform: translate(-50%, -65%) scale(1.2);
  }
  100% {
    opacity: 0;
    transform: translate(-50%, -90%) scale(1.5);
  }
}

/* DEKORASI LATAR */
.decor {
  position: absolute;
  z-index: 2;
  font-family: sans-serif;
  pointer-events: none;
  animation: floatDecor 4s ease-in-out infinite alternate;
}

@keyframes floatDecor {
  from { transform: translateY(0) rotate(-5deg); }
  to { transform: translateY(-15px) rotate(5deg); }
}

.moon {
  top: 10%;
  left: 9%;
  font-size: 35px;
}

.star {
  position: absolute;
  z-index: 2;
  color: #ff4a65;
  animation: twinkle 2s infinite alternate;
}

@keyframes twinkle {
  from { opacity: .2; transform: scale(.7); }
  to { opacity: 1; transform: scale(1.3); }
}

/* SALJU */
.snowflake {
  position: absolute;
  top: -30px;
  z-index: 3;
  color: white;
  font-family: sans-serif;
  pointer-events: none;
  animation: snowfall linear infinite;
}

@keyframes snowfall {
  0% { transform: translate(0, -20px) rotate(0); }
  50% { transform: translate(30px, 50vh) rotate(180deg); }
  100% { transform: translate(-20px, 110vh) rotate(360deg); }
}

/* PETASAN */
.fireworks {
  position: absolute;
  inset: 0;
  overflow: hidden;
  z-index: 6;
  pointer-events: none;
}

.firework {
  position: absolute;
  width: 4px;
  height: 4px;
  border-radius: 50%;
  background: var(--color);
  box-shadow: 0 0 8px var(--color), 0 0 18px var(--color);
  animation: burst 1.5s ease-out forwards;
}

@keyframes burst {
  0% {
    opacity: 1;
    transform: translate(0, 0) scale(1);
  }
  100% {
    opacity: 0;
    transform: translate(var(--dx), var(--dy)) scale(.1);
  }
}

.flash {
  position: absolute;
  width: 5px;
  height: 5px;
  border-radius: 50%;
  background: white;
  animation: flash 0.6s ease-out forwards;
}

@keyframes flash {
  0% {
    opacity: 1;
    box-shadow: 0 0 15px 8px white, 0 0 35px 18px #ff3040;
  }
  100% {
    opacity: 0;
    box-shadow: 0 0 0 0 transparent;
  }
}

@media (max-width: 600px) {
  .lyrics-area { top: 33%; }

  .lyric {
    width: 94%;
    font-size: 10px;
    line-height: 2.7;
  }

  .art { top: 68%; }
}
</style>
</head>

<body>
<div class="scene" id="scene">

  <div class="fireworks" id="fireworks"></div>

  <div class="decor moon">🌙</div>

  <div class="lyrics-area">
    <div class="lyric" id="lyric"></div>
  </div>

  <div class="art" id="art"></div>

</div>

<script>
const slides = [
  {
    text: "Hold me, I just want to feel you hold me",
    art: "🫂",
    type: "hug"
  },
  {
    text: "You know me, like nobody else could know me, ooh-woah",
    art: "💞",
    type: "heart"
  },
  {
    text: "You've been there through all my highs and lows",
    art: "🌦️",
    type: "weather"
  },
  {
    text: "I love you, but I gotta let you go",
    art: "💔",
    type: "release"
  },
  {
    text: "I love you, but I gotta let you go",
    art: "🫂",
    type: "memory"
  },
  {
    text: "I love you, but I gotta let you go (Ooh)",
    art: "🥀",
    type: "broken"
  },
  {
    text: "I love you, but I gotta let you go",
    art: "🕊️",
    type: "bird"
  },
  {
    text: "I love you, but I gotta let you go",
    art: "💔",
    type: "goodbye"
  }
];

const lyricElement = document.getElementById("lyric");
const artElement = document.getElementById("art");
const scene = document.getElementById("scene");
const fireworks = document.getElementById("fireworks");

let index = 0;

const LETTER_SPEED = 48;
const HOLD_TIME = 1200;
const EXIT_TIME = 450;
const SLIDE_DURATION = 4800;

function wait(ms) {
  return new Promise(resolve => setTimeout(resolve, ms));
}

/* LIRIK PER HURUF */
async function playSlides() {
  while (true) {
    const slide = slides[index];

    lyricElement.className = "lyric";
    lyricElement.innerHTML = "";

    artElement.className = "art";
    artElement.textContent = slide.art;

    void lyricElement.offsetWidth;
    void artElement.offsetWidth;

    artElement.classList.add(slide.type, "show");

    for (const character of slide.text) {
      const span = document.createElement("span");
      span.className = "letter";
      span.textContent = character;

      if (character === " ") {
        span.style.width = ".55em";
      }

      lyricElement.appendChild(span);
      await wait(LETTER_SPEED);
    }

    // Beri waktu membaca lirik
    await wait(HOLD_TIME);

    lyricElement.classList.add("fade-out");

    // Tunggu slide selesai sebelum beralih
    const elapsed = slide.text.length * LETTER_SPEED
                  + HOLD_TIME
                  + EXIT_TIME;

    await wait(Math.max(0, SLIDE_DURATION - elapsed));

    index = (index + 1) % slides.length;
  }
}

/* SALJU */
function createSnow() {
  const symbols = ["❄", "❅", "❆", "·", "✧"];

  for (let i = 0; i < 90; i++) {
    const flake = document.createElement("span");
    flake.className = "snowflake";
    flake.textContent =
      symbols[Math.floor(Math.random() * symbols.length)];

    flake.style.left = Math.random() * 100 + "%";
    flake.style.fontSize = (7 + Math.random() * 14) + "px";
    flake.style.animationDuration = (6 + Math.random() * 12) + "s";
    flake.style.animationDelay = (-Math.random() * 18) + "s";
    flake.style.opacity = .2 + Math.random() * .7;

    scene.appendChild(flake);
  }

  for (let i = 0; i < 18; i++) {
    const star = document.createElement("span");
    star.className = "star";
    star.textContent = Math.random() > .5 ? "✦" : "✧";
    star.style.left = Math.random() * 100 + "%";
    star.style.top = Math.random() * 100 + "%";
    star.style.fontSize = (8 + Math.random() * 15) + "px";
    star.style.animationDelay = Math.random() * 2 + "s";
    scene.appendChild(star);
  }
}

/* PETASAN WARNA-WARNI */
const colors = [
  "#ff3030",
  "#ffd700",
  "#ffffff",
  "#ff69b4",
  "#00ffff",
  "#ff8c00"
];

function launchFirework() {
  const x = 8 + Math.random() * 84;
  const y = 8 + Math.random() * 38;
  const color = colors[Math.floor(Math.random() * colors.length)];

  const flash = document.createElement("div");
  flash.className = "flash";
  flash.style.left = x + "%";
  flash.style.top = y + "%";
  fireworks.appendChild(flash);

  setTimeout(() => flash.remove(), 650);

  for (let i = 0; i < 32; i++) {
    const particle = document.createElement("span");
    particle.className = "firework";
    particle.style.left = x + "%";
    particle.style.top = y + "%";

    const angle = (Math.PI * 2 * i) / 32;
    const distance = 30 + Math.random() * 100;

    particle.style.setProperty("--dx", Math.cos(angle) * distance + "px");
    particle.style.setProperty("--dy", Math.sin(angle) * distance + "px");
    particle.style.setProperty("--color", color);

    fireworks.appendChild(particle);
    setTimeout(() => particle.remove(), 1600);
  }
}

function fireworksLoop() {
  launchFirework();
  setTimeout(fireworksLoop, 900 + Math.random() * 1200);
}

createSnow();
playSlides();
fireworksLoop();
</script>
</body>
</html>
